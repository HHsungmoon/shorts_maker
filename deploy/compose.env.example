# 레포 **루트** `.env` 템플릿(서버용).  cp deploy/compose.env.example .env
#
# docker compose 가 compose.yaml 을 읽을 때 자동으로 읽는 파일이다 — 컨테이너 안에 들어가는 값이 아니라
# compose 파일의 `${...}` 치환과 compose 자체의 설정에 쓰인다. 앱의 시크릿은 backend/.env(deploy.env.example)에 있다.
# gitignore 되어 있다(.env). 🔴 레포가 public 이다 — 토큰을 이 example 파일에 적지 않는다.

# cloudflared 서비스를 켠다. 이 줄이 있으면 `docker compose up -d` 가 db · shorts · cloudflared 셋을 띄운다.
COMPOSE_PROFILES=tunnel

# Cloudflare Zero Trust → Networks → Tunnels → (터널) → 설치 명령에 나오는 `eyJ...` 로 시작하는 긴 값.
# 🔴 이 값만 있으면 누구나 이 터널로 clipq.cloud 를 가로챌 수 있다. 새면 대시보드에서 터널 토큰을 갈아 끼운다.
CLOUDFLARE_TUNNEL_TOKEN=

# shorts 컨테이너 메모리 상한(기본 5g, compose.yaml). WSL2 에 잡힌 메모리(free -h)보다 작아야 한다.
# SHORTS_MEM_LIMIT=5g
