# 운영 서버(`~/shorts_maker/backend/.env`)용 템플릿. gitignore 되어 있어 git pull 이 건드리지 않는다.
# 이 파일은 커밋되지만 실제 값은 절대 여기 적지 않는다.
#
# 2026-11-15 다시 맞췄다 — 집 윈도우 PC + Cloudflare Tunnel. 그 전 판은 NCP 4GB VM
# 기준이라 whisper small 이었고 Jev·유튜브·보기 전용 비밀번호가 없었다.
# 터널 토큰은 여기가 아니라 **레포 루트 `.env`** 에 둔다(deploy/compose.env.example) — 이 파일은
# shorts·db 컨테이너에 통째로 들어가므로 cloudflared 의 토큰을 섞지 않는다.

# --- 외부 API -------------------------------------------------------------------
# Google AI Studio 키. 없으면 구간 분할·선정·자르기가 전부 거부된다(STT·렌더는 동작).
GEMINI_API_KEY=
# TypeSafe 콘솔(console.typesafe.ai/keys)의 Jev 키. 답하기의 후보 만들기·판정이 쓴다.
JEV_API_KEY=

# --- 인증 -----------------------------------------------------------------------
# 🔴 필수. 컨테이너는 0.0.0.0 에 바인딩하므로 비밀번호가 없으면 기동을 거부한다.
#   openssl rand -base64 24
SHORTS_ADMIN_PASSWORD=
# 보기 전용 비밀번호. 🔴 **공개된다**(/auth/me 가 무인증으로 내준다) — 다른 곳에서 쓰는 값을 재활용하지 않는다.
# 관리자 비밀번호와 같으면 기동을 거부한다. 비우면 보기 전용 역할이 없다.
SHORTS_READONLY_PASSWORD=
# 세션 수명(시간). 비밀번호를 바꾸면 기존 세션이 전부 끊긴다 — 유출됐을 때의 회수 수단이다.
SHORTS_SESSION_TTL_HOURS=12
# 기계 클라이언트용 토큰(X-Shorts-Token). 선택 — 스크립트로 API 를 부를 때만 채운다.
#   openssl rand -hex 32
SHORTS_API_TOKEN=

# 🔴 방문자 IP 를 읽는 헤더. **앞단에 선 것과 맞춘다** — 틀리면 레이트리밋·로그인 잠금을 위조로 피해 간다.
#   Cloudflare Tunnel 뒤(집 서버) → cf-connecting-ip
#   nginx 뒤(VM)                 → x-real-ip (기본값)
SHORTS_CLIENT_IP_HEADER=cf-connecting-ip

# --- Postgres -------------------------------------------------------------------
# 🔴 필수. db 컨테이너의 계정 비밀번호이자 앱의 접속 비밀번호. 한 번 정하면 볼륨을 지우기 전엔 못 바꾼다.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# --- 유튜브(업로드 · 댓글 · 성과) ----------------------------------------------------
# Google Cloud 콘솔 → Google 인증 플랫폼 → 클라이언트(웹 애플리케이션)의 값.
SHORTS_YOUTUBE_CLIENT_ID=
SHORTS_YOUTUBE_CLIENT_SECRET=
# 🔴 콘솔의 "승인된 리디렉션 URI" 와 글자 하나까지 같아야 한다. 스튜디오도 이 호스트로 열어야 한다.
SHORTS_YOUTUBE_REDIRECT_URI=https://clipq.cloud/api/youtube/callback

# --- 모델 · 단가 -------------------------------------------------------------------
# 단가는 자주 바뀌므로 아래 추정 단가도 함께 확인한다(`sm models` 로 목록 확인).
SHORTS_GEMINI_MODEL=gemini-3.6-flash
SHORTS_PRICE_INPUT_USD_PER_1M=0.75
SHORTS_PRICE_OUTPUT_USD_PER_1M=3.75
SHORTS_USD_KRW=1400
# whisper 는 코드 기본(large-v3)을 쓴다 — 이미지에 구운 모델과 같아야 첫 STT 가 다시 받지 않는다(Dockerfile).
# 메모리 4GB 대 머신에 올릴 때만 small 로 내리고 루트 .env 의 SHORTS_MEM_LIMIT=2600m 을 같이 둔다(compose.yaml).
# SHORTS_WHISPER_MODEL=small
