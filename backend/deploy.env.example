# 운영 서버(`~/shorts_maker/backend/.env`)용 템플릿. gitignore 되어 있어 git pull 이 건드리지 않는다.
# 이 파일은 커밋되지만 실제 값은 절대 여기 적지 않는다.

# Google AI Studio 키. 없으면 구간 분할·선정·자르기가 전부 거부된다(STT·렌더는 동작).
GEMINI_API_KEY=

# 🔴 필수. 컨테이너는 0.0.0.0 에 바인딩하므로 비밀번호가 없으면 기동을 거부한다.
# 브라우저가 직접 붙는 서비스라 이게 유일한 관문이다.
#   openssl rand -base64 24
SHORTS_ADMIN_PASSWORD=

# 🔴 필수. db 컨테이너의 계정 비밀번호이자 앱의 접속 비밀번호. 한 번 정하면 볼륨을 지우기 전엔 못 바꾼다.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# 세션 수명(시간). 비밀번호를 바꾸면 기존 세션이 전부 끊긴다 — 유출됐을 때의 회수 수단이다.
SHORTS_SESSION_TTL_HOURS=12

# 기계 클라이언트용 토큰(X-Shorts-Token). 선택 — 스크립트로 API 를 부를 때만 채운다.
#   openssl rand -hex 32
SHORTS_API_TOKEN=

# 모델. 단가는 자주 바뀌므로 아래 추정 단가도 함께 확인한다(`sm models` 로 목록 확인).
SHORTS_GEMINI_MODEL=gemini-3.6-flash
SHORTS_PRICE_INPUT_USD_PER_1M=0.75
SHORTS_PRICE_OUTPUT_USD_PER_1M=3.75
SHORTS_USD_KRW=1400

# 개발 루프용 small 이 운영 기본이다 — large-v3 는 10배 느리고 3.4GB 를 쓴다(설계 문서 §7).
SHORTS_WHISPER_MODEL=small
