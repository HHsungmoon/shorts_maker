# 로컬 개발용. 운영 서버는 deploy.env.example 을 쓴다.

# Google AI Studio 에서 발급한 키. 없으면 sm 이 LLM 단계에서 전부 실패한다(fail-closed).
GEMINI_API_KEY=

# doctor 가 이 모델이 실제로 존재하는지 확인한다. 문서 §7 의 모델/가격은 2026-08 기준
# 추정치라 실제 사용 가능한 ID 는 `sm doctor` 출력으로 확정한다.
SHORTS_GEMINI_MODEL=gemini-3.6-flash

# SQLite 파일. 스키마가 흔들리는 A 단계에서는 `sm db reset` 으로 자주 날린다.
SHORTS_DB_PATH=work/shorts.db

# 중간 산출물(청크·세그먼트 조각·프레임·렌더 결과).
SHORTS_WORK_DIR=work

# 입력 영상은 이 디렉토리 하위만 허용한다. 화면에서 임의 경로를 받게 되면 이 가드가
# 없을 때 서버의 아무 파일이나 읽히게 된다(C3).
SHORTS_SOURCE_DIR=work/sources

# --- 서버와 인증 -------------------------------------------------------------
SHORTS_API_HOST=127.0.0.1
SHORTS_API_PORT=8100

# 관리자 비밀번호. **비우면 로그인 화면이 뜨지 않는다** — 루프백 전용 로컬 개발 모드다.
# 🔴 루프백이 아닌 주소에 바인딩하려면 이 값이 반드시 있어야 한다(기동 시 검사).
# 로그인 화면을 로컬에서 확인하려면 아무 값이나 넣고 `sm serve` 를 다시 띄운다.
#   openssl rand -base64 24
SHORTS_ADMIN_PASSWORD=

# 세션 쿠키 수명(시간). 비밀번호를 바꾸면 기존 세션은 전부 무효가 된다.
SHORTS_SESSION_TTL_HOURS=12

# CLI·스크립트 같은 **기계 클라이언트**용 토큰(X-Shorts-Token). 브라우저는 세션 쿠키를
# 쓰므로 필요 없다. 예전에 Spring 백엔드가 프록시할 때 쓰던 값이고, 지금은 선택이다.
SHORTS_API_TOKEN=

# 빌드된 프론트의 위치. 없으면 `/` 가 개발용 단일 페이지로 폴백한다(`web/` 를 빌드하지
# 않아도 API 확인은 된다). 프론트를 붙여 보려면: cd ../web && npm install && npm run build
SHORTS_WEB_DIR=../web/dist

# --- 렌더 --------------------------------------------------------------------
# 🔴 자막 번인에는 libass 가 필요하다. Homebrew 의 기본 ffmpeg 는 libass 없이 빌드돼 있어
# `ass` 필터가 아예 없다(운영 Docker 의 데비안 ffmpeg 에는 들어 있다).
# macOS: brew install ffmpeg-full → 아래 경로를 쓴다. 없으면 렌더가 이유를 알려주고 멈춘다.
SHORTS_FFMPEG=ffmpeg
SHORTS_SUBTITLE_FONT=Apple SD Gothic Neo

# 비용 추정용 단가. 🔴 모델마다 다르고 자주 바뀐다 — 화면에는 "추정"으로 표시된다.
# 문서 §7 은 3.6 Flash 도입가 $0.75/$3.75 를 쓰고, 2027-01-01 2배 인상 예정이라고 적어놨다.
SHORTS_PRICE_INPUT_USD_PER_1M=0.75
SHORTS_PRICE_OUTPUT_USD_PER_1M=3.75
SHORTS_USD_KRW=1400
