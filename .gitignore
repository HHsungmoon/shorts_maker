# --- backend (python) ---
.venv/
__pycache__/
*.pyc
*.db
*.db-journal

# 중간 산출물(청크·프레임·렌더 결과)과 SQLite. 원본 영상이 GB 단위라 레포에 넣지 않는다.
backend/work/

# 원본 영상은 서버에 scp 로 올린다.
backend/sources/*
!backend/sources/.gitkeep

# --- web (node) ---
node_modules/
web/dist/

# --- 공통 ---
# 🔴 시크릿(GEMINI_API_KEY·SHORTS_ADMIN_PASSWORD)이 들어간다. 절대 커밋하지 않는다.
.env
.env.local
.DS_Store

.claude

# 설계 문서·기록·발표 자료는 로컬 전용이다. 레포에는 프로그램 코드와 README 만 올린다.
# (서버 구축 기록에는 공인 IP·도메인·계정 구성 같은 운영 정보도 들어 있다)
docs/

# 평가·시드용 데이터(질문 세트, 전사 교정 SQL)도 로컬 전용이다.
# 🔴 questions.json 만 예외 — `sm answers seed`·`eval-cluster` 의 기본 입력이고
# tests/answers/test_demo.py 가 이 파일을 읽는다. 빼면 새로 클론한 곳에서 테스트가 깨진다.
data/*
!data/questions.json

# 에이전트 작업 지침도 문서라 로컬 전용이다.
CLAUDE.md
